# From `supabase status` in the pnb-database repo (local dev) or your hosted project settings.
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the SMK API base URL (default shown).
SMK_API_BASE_URL=https://api.smk.dk/api/v1

# Port the control panel listens on.
PORT=4000
